# Public, non-secret site origin used for production canonical and social URLs.
# Replace the fixture before a production release.
NEXT_PUBLIC_SITE_URL=https://example.invalid

# Allowed values: development, preview, production.
# Development and preview render safe noindex metadata.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Server-only private Google Calendar source. Share the calendar with the
# service-account email as a reader; never expose these values as NEXT_PUBLIC_*.
GOOGLE_CALENDAR_ID=
# Use either an absolute local path or the complete JSON credential in a
# deployment secret. The JSON form takes precedence when both are present.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional source refresh/lookahead controls.
GOOGLE_CALENDAR_REFRESH_SECONDS=60
GOOGLE_CALENDAR_LOOKAHEAD_DAYS=365
